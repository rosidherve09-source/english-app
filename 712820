"Mots de liaison":[["and","et"],["but","mais"],["because","parce que"],["so","donc, alors"],["however","cependant"],["although","bien que"],["therefore","par conséquent"],["moreover","de plus"],["in addition","en plus"],["for example","par exemple"],["on the other hand","d'un autre côté"],["in conclusion","pour conclure"],["first, then, finally","d'abord, ensuite, enfin"],["despite","malgré"],["unless","à moins que"],["while","pendant que"],["whereas","alors que"]],
"Question tags":[["She is nice, isn't she?","Elle est gentille, n'est-ce pas ?"],["You like tea, don't you?","Tu aimes le thé, non ?"],["He didn't come, did he?","Il n'est pas venu, si ?"],["They can swim, can't they?","Ils savent nager, non ?"],["Let's go, shall we?","Allons-y, d'accord ?"],["Are you ready? — Yes, I am.","Tu es prêt ? — Oui."],["Do you speak English? — No, I don't.","Tu parles anglais ? — Non."]]
};

/* ============ Progression et répétition espacée ============ */
const dayNum=()=>{const d=new Date();return Math.floor((d.getTime()-d.getTimezoneOffset()*60000)/86400000)};
function markStudied(){const d=store.get("days",[]),t=dayNum();if(!d.includes(t)){d.push(t);store.set("days",d.slice(-400))}}
function streak(){const d=new Set(store.get("days",[]));let t=dayNum();if(!d.has(t))t--;let n=0;while(d.has(t)){n++;t--}return n}
const wkey=w=>w[0]+"|"+w[1];
const INTERVALS=[0,1,3,7,14];
function srsState(){const box=store.get("box",{}),t=dayNum(),due=[],fresh=[];allWords().forEach(w=>{const c=box[wkey(w)];if(!c)fresh.push(w);else if(c.due<=t)due.push(w)});return{box,due,fresh}}
function weak(w){const box=store.get("box",{});box[wkey(w)]={b:0,due:dayNum()};store.set("box",box)}
const shuf=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const addErr=k=>{const g=store.get("gerr",[]);if(!g.includes(k)){g.push(k);store.set("gerr",g)}};
const delErr=k=>{store.set("gerr",store.get("gerr",[]).filter(x=>x!==k))};

VIEWS.home=()=>{
  const s=srsState(),st=streak(),days=store.get("days",[]).length,mastered=Object.values(s.box).filter(c=>c.b>=3).length;
  const all=allWords(),wod=all[dayNum()%all.length];
  const rv=store.get("rev",{d:0,n:0}),today=rv.d===dayNum()?rv.n:0,gerr=store.get("gerr",[]).filter(k=>GQ[k]);
  M.innerHTML=`<div class="card"><div class="big">🔥 ${st} jour${st>1?"s":""} de suite</div>
  <p class="mut">${days} jour(s) d'étude au total · ${today} carte(s) révisée(s) aujourd'hui</p>
  <div class="row"><div><div class="big">${s.due.length}</div><span class="mut">à réviser</span></div><div><div class="big">${mastered}</div><span class="mut">maîtrisés</span></div><div><div class="big">${all.length}</div><span class="mut">mots</span></div></div>
  <button class="btn" id="go1" style="width:100%">🧠 Réviser maintenant</button></div>
  <div class="card"><h2>Mot du jour</h2><div class="w">${sayBtn(wod[0])}<div class="t"><b>${esc(wod[0])}</b>${esc(wod[1])}</div></div></div>
  <div class="card"><h2>Routine conseillée (15 min/jour)</h2>
  <p class="mut">1) Révise tes cartes (5 min). 2) Lis une fiche dans « Temps » ou « Règles » (5 min). 3) Fais un quiz ou une dictée (5 min). 4) Répète à voix haute dans « Parler ». Un peu chaque jour vaut mieux que beaucoup une fois par semaine.</p>
  ${gerr.length?`<button class="opt" id="ge">📝 Revoir mes ${gerr.length} erreur(s) de grammaire</button>`:""}</div>
  <details><summary>💾 Sauvegarder / restaurer ma progression</summary>
  <textarea id="bk" placeholder="Ta sauvegarde apparaîtra ici"></textarea>
  <div class="row"><button class="btn alt" id="ex">Exporter</button><button class="btn alt" id="im">Importer</button></div>
  <p class="mut">Avant de désinstaller l'appli, exporte et garde le texte (par exemple dans un message à toi-même). Colle-le ici pour tout retrouver.</p></details>`;
  $("#go1").onclick=()=>show("revise");
  if($("#ge"))$("#ge").onclick=()=>{show("quiz");runQuiz("gerr")};
  $("#ex").onclick=()=>{
    const o={};try{for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k.startsWith("eng_"))o[k]=localStorage.getItem(k)}}catch(e){}
    const t=JSON.stringify(o);$("#bk").value=t;
    try{navigator.clipboard.writeText(t);toast("Copié ✔")}catch(e){toast("Sélectionne et copie le texte")}};
  $("#im").onclick=()=>{
    try{const o=JSON.parse($("#bk").value);Object.keys(o).forEach(k=>{if(k.startsWith("eng_"))localStorage.setItem(k,o[k])});toast("Progression restaurée ✔");VIEWS.home()}catch(e){toast("Texte de sauvegarde invalide")}};
};

VIEWS.memo=()=>{
  const cats=Object.keys(MEMO);let cur=store.get("mc",cats[0]);if(!MEMO[cur])cur=cats[0];
  M.innerHTML=`<div class="chips">${cats.map(c=>`<button class="chip ${c===cur?"on":""}" data-c="${esc(c)}">${esc(c)}</button>`).join("")}</div>
  <div class="card">${MEMO[cur].map(w=>`<div class="w">${sayBtn(w[0])}<div class="t"><b>${esc(w[0])}</b>${esc(w[1])}</div></div>`).join("")}</div>`;
  M.querySelectorAll(".chip").forEach(b=>b.onclick=()=>{store.set("mc",b.dataset.c);VIEWS.memo()});
};

VIEWS.revise=()=>{
  const s=srsState();let queue=shuf(s.due).slice(0,15);
  if(queue.length<15)queue=queue.concat(shuf(s.fresh).slice(0,Math.min(5,15-queue.length)));
  let i=0,ok=0;const again=new Set();
  if(!queue.length){M.innerHTML=`<div class="card"><div class="big">Rien à réviser 🎉</div><p class="mut">Reviens demain : tes prochaines cartes arriveront au bon moment.</p></div>`;return}
  const step=()=>{
    if(i>=queue.length){
      markStudied();
      M.innerHTML=`<div class="card"><div class="big">Session terminée ✔</div><p>${ok} bonne(s) réponse(s) sur ${queue.length}.</p><div class="row"><button class="btn" id="more">Continuer</button><button class="btn alt" id="hm">Accueil</button></div></div>`;
      $("#more").onclick=VIEWS.revise;$("#hm").onclick=()=>show("home");return;
    }
    const w=queue[i];
    M.innerHTML=`<div class="card"><p class="mut">Carte ${i+1}/${queue.length}</p><div class="big">${esc(w[0])} ${sayBtn(w[0])}</div>
    <div id="an" class="hide" style="margin:14px 0;font-size:20px">${esc(w[1])}</div>
    <button class="btn alt" id="rv" style="width:100%">Voir la réponse</button>
    <div class="row" id="jb" style="display:none"><button class="btn" id="yes" style="background:var(--ok)">✔ Je savais</button><button class="btn" id="no" style="background:var(--ko)">✘ À revoir</button></div></div>`;
    speak(w[0]);
    $("#rv").onclick=()=>{$("#an").classList.remove("hide");$("#rv").style.display="none";$("#jb").style.display="flex"};
    const grade=good=>{
      const box=store.get("box",{}),k=wkey(w),c=box[k]||{b:0,due:0};
      if(good){c.b=Math.min(c.b+1,4);c.due=dayNum()+INTERVALS[c.b];ok++}
      else{c.b=0;c.due=dayNum();if(!again.has(k)){again.add(k);queue.push(w)}}
      box[k]=c;store.set("box",box);
      let rv=store.get("rev",{d:0,n:0});if(rv.d!==dayNum())rv={d:dayNum(),n:0};rv.n++;store.set("rev",rv);
      i++;step();
    };
    $("#yes").onclick=()=>grade(true);$("#no").onclick=()=>grade(false);
  };
  step();
};

/* ---- Quiz ---- */
VIEWS.quiz=()=>{
  const best=store.get("best",{}),ge=store.get("gerr",[]).filter(k=>GQ[k]);
  const b=m=>best[m]!=null?`<span class="mut">(meilleur : ${best[m]}/10)</span>`:"";
  M.innerHTML=`<div class="card"><h2>Choisis un quiz</h2>
  <button class="opt" data-q="gram">📘 Choisir le bon temps / la bonne règle ${b("gram")}</button>
  <button class="opt" data-q="conj">🔁 Conjugaison (écrire la forme) ${b("conj")}</button>
  <button class="opt" data-q="en">🔤 Vocabulaire : anglais → français ${b("en")}</button>
  <button class="opt" data-q="fr">🔤 Vocabulaire : français → anglais ${b("fr")}</button>
  <button class="opt" data-q="dict">🎧 Dictée : écoute et écris ${b("dict")}</button>
  ${ge.length?`<button class="opt" data-q="gerr">📝 Mes erreurs de grammaire (${ge.length})</button>`:""}</div>`;
  M.querySelectorAll("[data-q]").forEach(b=>b.onclick=()=>runQuiz(b.dataset.q));
};
function runQuiz(mode){
  let i=0,score=0,qs;
  if(mode==="gram")qs=shuf(GQ.map((q,k)=>[...q,k])).slice(0,10);
  else if(mode==="gerr")qs=shuf(store.get("gerr",[]).filter(k=>GQ[k]).map(k=>[...GQ[k],k])).slice(0,10);
  else if(mode==="conj"){
    const vs=[...Object.keys(IRR),...REG];
    qs=Array.from({length:10},()=>({v:vs[Math.floor(Math.random()*vs.length)],s:SUBJ[Math.floor(Math.random()*SUBJ.length)],t:Math.floor(Math.random()*12)}));
  }else if(mode==="dict"){
    const ph=shuf(Object.values(PHRASES).flat().map(x=>x[0]).filter(x=>!x.includes("…"))).slice(0,5);
    const wd=shuf(allWords().map(x=>x[0].replace(/^to /,""))).slice(0,5);
    qs=shuf([...ph,...wd]);
  }else{
    qs=shuf(allWords()).slice(0,10).map(x=>{const pool=allWords().filter(y=>y[0]!==x[0]&&y[1]!==x[1]);return{w:x,opts:shuf([x,...shuf(pool).slice(0,3)])}});
  }
  const N=qs.length;
  if(!N){toast("Rien à faire ici pour l'instant");VIEWS.quiz();return}
  const finish=()=>{
    markStudied();
    if(mode!=="gerr"){const best=store.get("best",{});if(best[mode]==null||score>best[mode])best[mode]=score;store.set("best",best)}
    M.innerHTML=`<div class="card"><div class="big">${score} / ${N}</div><p>${score>=8*N/10?"Excellent ! 🎉":score>=N/2?"Bien, continue ! 💪":"Révise puis réessaie 📘"}</p><div class="row"><button class="btn" id="again">Rejouer</button><button class="btn alt" id="menu">Menu</button></div></div>`;
    $("#again").onclick=()=>runQuiz(mode);$("#menu").onclick=VIEWS.quiz;
  };
  const next=()=>{
    if(i>=N)return finish();
    const q=qs[i];
    if(mode==="gram"||mode==="gerr"){
      M.innerHTML=`<div class="card"><p class="mut">Question ${i+1}/${N} · Score ${score}</p><div class="big">${esc(q[0])}</div>${q[1].map((o,k)=>`<button class="opt" data-k="${k}">${esc(o)}</button>`).join("")}<div id="fb"></div></div>`;
      M.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{
        const k=+b.dataset.k;M.querySelectorAll(".opt").forEach(x=>x.disabled=true);
        M.querySelectorAll(".opt")[q[2]].classList.add("ok");
        if(k===q[2]){score++;delErr(q[4])}else{b.classList.add("ko");addErr(q[4])}
        $("#fb").innerHTML=`<p class="mut">${esc(q[3])}</p><button class="btn" id="nx">Suivant</button>`;
        $("#nx").onclick=()=>{i++;next()};
      });
    }else if(mode==="conj"){
      const exp=build(q.v,q.s,"aff")[q.t],te=TENSES[q.t];
      M.innerHTML=`<div class="card"><p class="mut">Question ${i+1}/${N} · Score ${score}</p><div class="big">${esc(q.v)} · ${esc(q.s)}</div><p>${esc(te.n)} <span class="mut">(${esc(te.fr)})</span></p><input id="ans" autocapitalize="none" placeholder="Écris la phrase complète, ex : ${esc(q.s)} …"><div class="row"><button class="btn" id="ck">Vérifier</button></div><div id="fb"></div></div>`;
      $("#ck").onclick=()=>{
        const n=s=>s.toLowerCase().trim().replace(/\s+/g," ");
        const a=n($("#ans").value),e=n(exp),bare=e.split(" ").slice(1).join(" ");
        const ok=a===e||a===bare;if(ok)score++;
        $("#ck").disabled=true;
        $("#fb").innerHTML=`<p class="${ok?"ok-t":"ko-t"}">${ok?"Correct ✔":"Faux ✘"} — réponse : <b>${esc(exp)}</b></p><button class="btn" id="nx">Suivant</button>`;
        $("#nx").onclick=()=>{i++;next()};
      };
    }else if(mode==="dict"){
      M.innerHTML=`<div class="card"><p class="mut">Dictée ${i+1}/${N} · Score ${score}</p><div class="big">🎧 Écoute et écris</div><button class="btn alt" id="pl" style="width:100%;margin:8px 0">🔊 Réécouter</button><input id="ans" autocapitalize="none" placeholder="Ce que tu entends…"><div class="row"><button class="btn" id="ck">Vérifier</button></div><div id="fb"></div></div>`;
      setTimeout(()=>speak(q),300);
      $("#pl").onclick=()=>speak(q);
      $("#ck").onclick=()=>{
        const n=s=>s.toLowerCase().replace(/[^a-z0-9' ]/g,"").replace(/\s+/g," ").trim();
        const ok=n($("#ans").value)===n(q);if(ok)score++;
        $("#ck").disabled=true;
        $("#fb").innerHTML=`<p class="${ok?"ok-t":"ko-t"}">${ok?"Correct ✔":"Presque ✘"} — réponse : <b>${esc(q)}</b></p><button class="btn" id="nx">Suivant</button>`;
        $("#nx").onclick=()=>{i++;next()};
      };
    }else{
      const en=mode==="en";
      M.innerHTML=`<div class="card"><p class="mut">Question ${i+1}/${N} · Score ${score}</p><div class="big">${esc(en?q.w[0]:q.w[1])} ${en?sayBtn(q.w[0]):""}</div>${q.opts.map((o,k)=>`<button class="opt" data-k="${k}">${esc(en?o[1]:o[0])}</button>`).join("")}<div id="fb"></div></div>`;
      M.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{
        const k=+b.dataset.k,good=q.opts.indexOf(q.w);
        M.querySelectorAll(".opt").forEach(x=>x.disabled=true);
        M.querySelectorAll(".opt")[good].classList.add("ok");
        if(k===good)score++;else{b.classList.add("ko");weak(q.w)}
        $("#fb").innerHTML=`<button class="btn" id="nx" style="margin-top:8px">Suivant</button>`;
        $("#nx").onclick=()=>{i++;next()};
      });
    }
  };
  next();
}

{const f=store.get("tab","home");show(VIEWS[f]?f:"home")}
</script>
