<script>
/* ============ Utilitaires ============ */
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const store={get(k,d){try{const v=JSON.parse(localStorage.getItem("eng_"+k));return v==null?d:v}catch(e){return d}},set(k,v){try{localStorage.setItem("eng_"+k,JSON.stringify(v))}catch(e){}}};
const cap=x=>x.charAt(0).toUpperCase()+x.slice(1);
function toast(m){const t=$("#toast");t.textContent=m;t.style.display="block";clearTimeout(toast.h);toast.h=setTimeout(()=>t.style.display="none",2600)}
function speak(t){
  if(!("speechSynthesis" in window)){toast("Synthèse vocale non disponible sur ce navigateur");return}
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(t);u.lang="en-US";
  const vs=speechSynthesis.getVoices().filter(v=>v.lang&&v.lang.toLowerCase().startsWith("en"));
  const v=vs.find(x=>x.name===store.get("voice",""))||vs[0];
  if(v){u.voice=v;u.lang=v.lang}else toast("Aucune voix anglaise trouvée : installe-la dans Paramètres > Synthèse vocale");
  u.rate=store.get("rate",0.9);
  speechSynthesis.speak(u);
}
document.addEventListener("click",e=>{const b=e.target.closest("[data-say]");if(b)speak(b.dataset.say)});
const sayBtn=t=>`<button class="say" data-say="${esc(t)}" aria-label="Écouter">🔊</button>`;

/* ============ Données : les 12 temps ============ */
const TENSES=[
{n:"Present Simple",fr:"Présent simple",f:"S + verbe (+s/es à he, she, it)",u:["Habitudes et routines","Vérités générales","Horaires, programmes"],sig:"always, usually, often, sometimes, never, every day",ex:[["She works every day.","Elle travaille tous les jours."],["Water boils at 100°C.","L'eau bout à 100 °C."],["Does he like tea?","Est-ce qu'il aime le thé ?"]]},
{n:"Present Continuous",fr:"Présent continu",f:"S + am/is/are + verbe-ing",u:["Action en cours en ce moment","Projet proche et organisé","Situation temporaire"],sig:"now, at the moment, currently, today, these days",ex:[["I am studying English now.","J'étudie l'anglais en ce moment."],["They are not playing.","Ils ne jouent pas."],["We are meeting him tomorrow.","Nous le rencontrons demain."]]},
{n:"Past Simple",fr:"Prétérit simple",f:"S + verbe-ed (ou forme irrégulière)",u:["Action terminée dans le passé","Série d'actions passées"],sig:"yesterday, last week, ago, in 2020, when",ex:[["I visited Lomé last year.","J'ai visité Lomé l'année dernière."],["She went home and ate.","Elle est rentrée et a mangé."],["Did you see him?","Tu l'as vu ?"]]},
{n:"Past Continuous",fr:"Prétérit continu",f:"S + was/were + verbe-ing",u:["Action en cours à un moment passé","Action longue interrompue par une autre"],sig:"while, when, at 8 o'clock yesterday",ex:[["I was reading when he called.","Je lisais quand il a appelé."],["They were sleeping at midnight.","Ils dormaient à minuit."]]},
{n:"Present Perfect",fr:"Présent parfait",f:"S + have/has + participe passé",u:["Expérience de vie","Action passée avec lien avec le présent","Résultat visible maintenant"],sig:"ever, never, already, yet, just, since, for, so far",ex:[["I have never been to London.","Je ne suis jamais allé à Londres."],["She has just left.","Elle vient de partir."],["We have lived here for 5 years.","Nous vivons ici depuis 5 ans."]]},
{n:"Present Perfect Continuous",fr:"Présent parfait continu",f:"S + have/has + been + verbe-ing",u:["Action commencée dans le passé et toujours en cours","Insister sur la durée"],sig:"for, since, all day, lately, recently",ex:[["I have been studying for two hours.","J'étudie depuis deux heures."],["It has been raining since morning.","Il pleut depuis ce matin."]]},
{n:"Past Perfect",fr:"Plus-que-parfait",f:"S + had + participe passé",u:["Action antérieure à une autre action passée"],sig:"before, after, by the time, already",ex:[["When I arrived, the film had started.","Quand je suis arrivé, le film avait commencé."],["She had already eaten.","Elle avait déjà mangé."]]},
{n:"Past Perfect Continuous",fr:"Plus-que-parfait continu",f:"S + had been + verbe-ing",u:["Durée d'une action avant un moment passé"],sig:"for, since, before",ex:[["He had been working for hours when I called.","Il travaillait depuis des heures quand j'ai appelé."]]},
{n:"Future Simple (will)",fr:"Futur simple",f:"S + will + base",u:["Décision spontanée","Prédiction","Promesse, offre"],sig:"tomorrow, next week, soon, I think, probably",ex:[["I will help you.","Je vais t'aider."],["It will rain tomorrow.","Il pleuvra demain."],["Will you come?","Tu viendras ?"]]},
{n:"Be going to",fr:"Futur proche",f:"S + am/is/are + going to + base",u:["Intention déjà décidée","Prédiction basée sur un indice"],sig:"tonight, next month, look at those clouds",ex:[["I am going to study tonight.","Je vais étudier ce soir."],["Look! It is going to rain.","Regarde ! Il va pleuvoir."]]},
{n:"Future Continuous",fr:"Futur continu",f:"S + will be + verbe-ing",u:["Action en cours à un moment futur précis"],sig:"this time tomorrow, at 5 pm tomorrow",ex:[["This time tomorrow I will be flying.","Demain à cette heure, je serai en train de voler."]]},
{n:"Future Perfect",fr:"Futur antérieur",f:"S + will have + participe passé",u:["Action terminée avant un moment futur"],sig:"by + date, by the time",ex:[["I will have finished by Friday.","J'aurai fini d'ici vendredi."],["She will have graduated by 2030.","Elle aura obtenu son diplôme d'ici 2030."]]}
];

/* ============ Règles de grammaire ============ */
const GRAMMAR=[
{t:"A / An / The (articles)",b:`<p><b>a</b> + son consonne : <i>a book, a university</i> (son « you »).<br><b>an</b> + son voyelle : <i>an apple, an hour</i> (h muet).<br><b>the</b> = chose précise / déjà connue : <i>The book on the table.</i><br>Pas d'article pour le général : <i>I like music.</i></p>`},
{t:"Pluriel des noms",b:`<p>+s : <i>book → books</i><br>+es (s, x, z, ch, sh) : <i>box → boxes</i><br>consonne+y → ies : <i>city → cities</i><br>f/fe → ves : <i>knife → knives</i><br>Irréguliers : <i>man → men, woman → women, child → children, foot → feet, tooth → teeth, person → people, mouse → mice</i><br>Invariables : <i>sheep, fish, series</i></p>`},
{t:"Pronoms sujets, objets, possessifs",b:`<table><tr><th>Sujet</th><th>Objet</th><th>Adj. poss.</th><th>Pron. poss.</th></tr>
<tr><td>I</td><td>me</td><td>my</td><td>mine</td></tr><tr><td>you</td><td>you</td><td>your</td><td>yours</td></tr><tr><td>he</td><td>him</td><td>his</td><td>his</td></tr><tr><td>she</td><td>her</td><td>her</td><td>hers</td></tr><tr><td>it</td><td>it</td><td>its</td><td>—</td></tr><tr><td>we</td><td>us</td><td>our</td><td>ours</td></tr><tr><td>they</td><td>them</td><td>their</td><td>theirs</td></tr></table>
<p class="mut">Possession : <i>Peter's book</i> (nom + 's).</p>`},
{t:"Comparatifs et superlatifs",b:`<p>Court : <i>tall → taller → the tallest</i><br>Long : <i>more / the most</i> + adj : <i>more interesting, the most interesting</i><br>Irréguliers : <i>good → better → the best ; bad → worse → the worst ; far → farther → the farthest</i><br>Égalité : <i>as tall as</i> · Infériorité : <i>less … than</i></p>`},
{t:"Verbes modaux",b:`<p>Toujours + base, sans -s, sans « to ».<br><b>can</b> capacité/permission · <b>could</b> capacité passée / demande polie<br><b>may/might</b> possibilité · <b>must</b> obligation forte / déduction<br><b>have to</b> obligation externe · <b>should</b> conseil · <b>would</b> politesse, conditionnel<br><i>You should study. She can swim. May I come in?</i><br>Négation : <i>cannot / can't, mustn't</i> (interdiction), <i>don't have to</i> (pas obligé).</p>`},
{t:"Conditionnels (0, 1, 2, 3)",b:`<div class="f">0 : If + présent, présent</div><p><i>If you heat ice, it melts.</i> (vérité générale)</p>
<div class="f">1 : If + présent, will + base</div><p><i>If it rains, I will stay home.</i> (réel/probable)</p>
<div class="f">2 : If + prétérit, would + base</div><p><i>If I had money, I would travel.</i> (irréel présent) — on dit <i>If I were you…</i></p>
<div class="f">3 : If + past perfect, would have + pp</div><p><i>If I had studied, I would have passed.</i> (irréel passé)</p>`},
{t:"La voix passive",b:`<div class="f">be (au temps voulu) + participe passé</div><p><i>The letter is written. / was written. / will be written. / has been written.</i><br>Actif : <i>Tom broke the window.</i> → Passif : <i>The window was broken (by Tom).</i></p>`},
{t:"Discours rapporté",b:`<p>On « recule » le temps : <i>present → past, will → would, can → could, now → then, today → that day, tomorrow → the next day</i>.<br><i>"I am tired." → She said (that) she was tired.</i><br>Questions : ordre affirmatif, sans do : <i>He asked where I lived.</i></p>`},
{t:"Prépositions : in / on / at",b:`<p><b>Temps</b> : <i>at</i> 5 pm, at night · <i>on</i> Monday, on May 5th · <i>in</i> June, in 2026, in the morning.<br><b>Lieu</b> : <i>at</i> school (point) · <i>on</i> the table (surface) · <i>in</i> Togo, in the room (intérieur).</p>`},
{t:"Some / Any / Much / Many / A lot of",b:`<p><b>some</b> affirmatif : <i>I have some books.</i><br><b>any</b> négatif/question : <i>I don't have any. Do you have any?</i><br><b>many</b> + dénombrable : <i>many students</i> · <b>much</b> + indénombrable : <i>much water</i> (surtout négatif/question)<br><b>a lot of</b> = les deux, affirmatif. <b>few/a few</b> (dénombrable), <b>little/a little</b> (indénombrable).</p>`},
{t:"Former une question",b:`<p><b>Être / modal / auxiliaire</b> : inversion → <i>Are you ready? Can she swim? Have they left?</i><br><b>Autres verbes</b> : do/does/did + sujet + base → <i>Do you like it? Did he come?</i><br><b>Mots interrogatifs</b> : what, where, when, why, who, how (much/many/long/old) + question → <i>Where do you live?</i><br>Sujet = mot interrogatif : pas de do → <i>Who called you?</i></p>`},
{t:"There is / There are",b:`<p><i>There is a book. There are two books. Is there a bank? There isn't any milk.</i><br>Passé : <i>there was / there were</i> · Futur : <i>there will be</i>.</p>`},
{t:"Used to / Be used to / Get used to",b:`<p><b>used to + base</b> = habitude passée révolue : <i>I used to play football.</i><br><b>be used to + -ing</b> = être habitué : <i>I am used to waking up early.</i><br><b>get used to + -ing</b> = s'habituer.</p>`},
{t:"Gérondif (-ing) ou infinitif (to) ?",b:`<p><b>+ -ing</b> : enjoy, finish, avoid, mind, keep, suggest, give up, look forward to.<br><b>+ to</b> : want, need, hope, decide, plan, promise, learn, would like.<br><b>Les deux</b> : like, love, start, begin.<br>Changement de sens : <i>stop doing</i> (arrêter) / <i>stop to do</i> (s'arrêter pour).</p>`},
{t:"Propositions relatives",b:`<p><b>who</b> (personne) · <b>which</b> (chose) · <b>that</b> (les deux) · <b>whose</b> (appartenance) · <b>where</b> (lieu).<br><i>The man who called is my uncle. The book that I read was great.</i></p>`},
{t:"Orthographe : -ing, -ed, -s",b:`<p><b>-ing</b> : <i>make → making</i> (on retire e) · <i>run → running</i> (on double) · <i>lie → lying</i> · <i>play → playing</i>.<br><b>-ed</b> : <i>study → studied</i> · <i>stop → stopped</i> · <i>like → liked</i>.<br><b>he/she/it</b> : <i>go → goes, study → studies, have → has</i>.</p>`}
];

/* ============ Verbes irréguliers (base → [prétérit, participe passé]) ============ */
const IRR={be:["was/were","been"],have:["had","had"],do:["did","done"],go:["went","gone"],see:["saw","seen"],take:["took","taken"],make:["made","made"],come:["came","come"],get:["got","gotten"],give:["gave","given"],know:["knew","known"],think:["thought","thought"],say:["said","said"],tell:["told","told"],find:["found","found"],eat:["ate","eaten"],drink:["drank","drunk"],write:["wrote","written"],read:["read","read"],speak:["spoke","spoken"],buy:["bought","bought"],bring:["brought","brought"],begin:["began","begun"],break:["broke","broken"],build:["built","built"],choose:["chose","chosen"],feel:["felt","felt"],forget:["forgot","forgotten"],hear:["heard","heard"],keep:["kept","kept"],leave:["left","left"],lose:["lost","lost"],meet:["met","met"],pay:["paid","paid"],put:["put","put"],run:["ran","run"],sell:["sold","sold"],send:["sent","sent"],sit:["sat","sat"],sleep:["slept","slept"],stand:["stood","stood"],swim:["swam","swum"],teach:["taught","taught"],understand:["understood","understood"],win:["won","won"],wear:["wore","worn"],sing:["sang","sung"],fall:["fell","fallen"],draw:["drew","drawn"],drive:["drove","driven"],fly:["flew","flown"],grow:["grew","grown"],hold:["held","held"],let:["let","let"],cut:["cut","cut"],hit:["hit","hit"],cost:["cost","cost"],mean:["meant","meant"],lend:["lent","lent"],ride:["rode","ridden"],rise:["rose","risen"],shut:["shut","shut"],throw:["threw","thrown"],wake:["woke","woken"],spend:["spent","spent"],catch:["caught","caught"],fight:["fought","fought"],hide:["hid","hidden"],show:["showed","shown"],steal:["stole","stolen"],lead:["led","led"],set:["set","set"],pick:["picked","picked"]};
const IRR_FR={be:"être",have:"avoir",do:"faire",go:"aller",see:"voir",take:"prendre",make:"fabriquer/faire",come:"venir",get:"obtenir",give:"donner",know:"savoir",think:"penser",say:"dire",tell:"raconter",find:"trouver",eat:"manger",drink:"boire",write:"écrire",read:"lire",speak:"parler",buy:"acheter",bring:"apporter",begin:"commencer",break:"casser",build:"construire",choose:"choisir",feel:"ressentir",forget:"oublier",hear:"entendre",keep:"garder",leave:"partir",lose:"perdre",meet:"rencontrer",pay:"payer",put:"mettre",run:"courir",sell:"vendre",send:"envoyer",sit:"s'asseoir",sleep:"dormir",stand:"se tenir debout",swim:"nager",teach:"enseigner",understand:"comprendre",win:"gagner",wear:"porter",sing:"chanter",fall:"tomber",draw:"dessiner",drive:"conduire",fly:"voler",grow:"grandir",hold:"tenir",let:"laisser",cut:"couper",hit:"frapper",cost:"coûter",mean:"signifier",lend:"prêter",ride:"monter",rise:"se lever",shut:"fermer",throw:"jeter",wake:"se réveiller",spend:"dépenser",catch:"attraper",fight:"se battre",hide:"cacher",show:"montrer",steal:"voler (dérober)",lead:"diriger",set:"poser",pick:"cueillir/choisir"};
const REG=["work","play","study","learn","walk","talk","love","like","want","need","help","watch","visit","wait","open","close","live","start","use","try","stop","plan","listen","call","cook","clean","travel","download","answer","ask"];

/* ============ Moteur de conjugaison ============ */
const vow=/[aeiou]/;
function groups(w){return (w.match(/[aeiouy]+/g)||[]).length}
function doubles(v){return /[^aeiou][aeiou][^aeiouwxy]$/.test(v)&&(groups(v)===1||["begin","forget","prefer","admit","occur","refer","permit","regret","control","commit","upset"].includes(v))}
function ingForm(v){
  if(v==="be")return "being";
  if(v.endsWith("ie"))return v.slice(0,-2)+"ying";
  if(v.endsWith("ee")||v.endsWith("ye")||v.endsWith("oe"))return v+"ing";
  if(v.endsWith("e"))return v.slice(0,-1)+"ing";
  if(doubles(v))return v+v.slice(-1)+"ing";
  return v+"ing";
}
function edForm(v){
  if(v.endsWith("e"))return v+"d";
  if(/[^aeiou]y$/.test(v))return v.slice(0,-1)+"ied";
  if(doubles(v))return v+v.slice(-1)+"ed";
  return v+"ed";
}
function thirdForm(v){
  if(v==="have")return "has";if(v==="be")return "is";
  if(/(s|x|z|ch|sh|o)$/.test(v))return v+"es";
  if(/[^aeiou]y$/.test(v))return v.slice(0,-1)+"ies";
  return v+"s";
}
function info(v){
  v=v.trim().toLowerCase();
  const irr=IRR[v];
  return {v,irr:!!irr,past:irr?irr[0]:edForm(v),pp:irr?irr[1]:edForm(v),ing:ingForm(v),third:thirdForm(v)};
}
const NEG={am:"am not",is:"isn't",are:"aren't",was:"wasn't",were:"weren't",have:"haven't",has:"hasn't",had:"hadn't",will:"won't",would:"wouldn't",do:"don't",does:"doesn't",did:"didn't"};
const SUBJ=["I","you","he","she","it","we","they"];
function build(v,s,mode){
  const I=info(v),th=["he","she","it"].includes(s);
  const beP=s==="I"?"am":(th?"is":"are"),beW=(s==="I"||th)?"was":"were",hv=th?"has":"have",isBe=I.v==="be";
  const mk=(aux,main)=>{main=main?" "+main:"";
    if(mode==="aff")return `${cap(s)} ${aux}${main}`;
    if(mode==="neg")return `${cap(s)} ${NEG[aux]}${main}`;
    return `${cap(aux)} ${s}${main}?`};
  const ds=th?"does":"do";
  const ps=isBe?mk(beP,""):(mode==="aff"?`${cap(s)} ${th?I.third:I.v}`:mk(ds,I.v));
  const pa=isBe?mk(beW,""):(mode==="aff"?`${cap(s)} ${I.past}`:mk("did",I.v));
  return [
    ps, mk(beP,I.ing), pa, mk(beW,I.ing), mk(hv,I.pp), mk(hv,"been "+I.ing),
    mk("had",I.pp), mk("had","been "+I.ing), mk("will",I.v), mk(beP,"going to "+I.v),
    mk("will","be "+I.ing), mk("will","have "+I.pp)
  ];
}

/* ============ Vocabulaire ============ */
