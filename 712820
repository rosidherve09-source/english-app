function allWords(){
  const a=[];Object.values(VOC).forEach(l=>l.forEach(w=>a.push(w)));
  Object.keys(IRR_FR).forEach(k=>a.push(["to "+k,IRR_FR[k]]));
  store.get("mine",[]).forEach(w=>a.push(w));
  const seen=new Set();
  return a.filter(w=>{const k=w[0].toLowerCase()+"|"+w[1].toLowerCase();if(seen.has(k))return false;seen.add(k);return true});
}
