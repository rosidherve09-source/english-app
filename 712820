  const cats=Object.keys(VOC);let cur=store.get("vc",cats[0]),hid=store.get("vh",false);
  const render=()=>{
    const list=cur==="Mes mots"?store.get("mine",[]):VOC[cur];
    M.innerHTML=`<div class="chips">${[...cats,"Mes mots"].map(c=>`<button class="chip ${c===cur?"on":""}" data-c="${esc(c)}">${esc(c)}</button>`).join("")}</div>
    <label class="mut"><input type="checkbox" id="vh" ${hid?"checked":""} style="width:auto"> Cacher le français (touche pour révéler)</label>
