VIEWS.trad=()=>{
  M.innerHTML=`<div class="card"><h2>Dictionnaire FR ⇄ EN</h2>
  <input id="tq" placeholder="Un mot en français ou en anglais…" autocapitalize="none">
  <div id="tr"></div>
  <p class="mut">Hors-ligne, l'appli traduit des mots et des expressions de sa base. Pour traduire n'importe quelle phrase, demande-moi dans Claude quand tu as du réseau.</p></div>
  <div class="card"><h2>Ajouter mon mot</h2><div class="row"><input id="ae" placeholder="Anglais"><input id="af" placeholder="Français"></div><button class="btn" id="ab">Enregistrer</button></div>
  <h2>Phrases utiles</h2>`+
  Object.entries(PHRASES).map(([k,l])=>`<details><summary>${esc(k)}</summary>${l.map(e=>`<div class="ex"><div>${esc(e[0])}<i>${esc(e[1])}</i></div>${sayBtn(e[0])}</div>`).join("")}<p></p></details>`).join("");
  const norm=s=>s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/^to /,"");
  $("#tq").addEventListener("input",e=>{
    const q=norm(e.target.value.trim());if(!q){$("#tr").innerHTML="";return}
    const all=[...allWords(),...Object.values(PHRASES).flat(),...Object.values(MEMO).flat()];
    const r=all.filter(w=>norm(w[0]).includes(q)||norm(w[1]).includes(q)).slice(0,25);
    $("#tr").innerHTML=r.length?r.map(w=>`<div class="w">${sayBtn(w[0])}<div class="t"><b>${esc(w[0])}</b>${esc(w[1])}</div></div>`).join(""):`<p class="mut">Pas trouvé dans la base. Ajoute-le ci-dessous !</p>`;
  });
  $("#ab").onclick=()=>{const a=$("#ae").value.trim(),f=$("#af").value.trim();if(!a||!f){toast("Remplis les deux champs");return}
    const m=store.get("mine",[]);m.push([a,f]);store.set("mine",m);$("#ae").value=$("#af").value="";toast("Mot enregistré ✔")};
};

VIEWS.parler=()=>{
  const voices=()=>("speechSynthesis" in window)?speechSynthesis.getVoices().filter(v=>v.lang&&v.lang.toLowerCase().startsWith("en")):[];
  M.innerHTML=`<div class="card"><h2>Écouter n'importe quel texte</h2>
  <textarea id="pt" placeholder="Colle ou écris une phrase en anglais…">${esc(store.get("pt","I have been learning English for two months."))}</textarea>
  <div class="row"><button class="btn" id="pb">🔊 Écouter</button><button class="btn alt" id="ps">⏹ Stop</button></div>
  <label class="mut">Vitesse : <span id="rv"></span></label><input type="range" id="pr" min="0.5" max="1.3" step="0.1" value="${store.get("rate",0.9)}">
  <select id="pv" style="margin-top:8px"></select>
  <p class="mut">Si tu n'entends rien : Paramètres du téléphone → Gestion générale → Langue → Synthèse vocale → installe la voix anglaise (une seule fois, puis tout marche hors-ligne).</p></div>

  <div class="card"><h2>🎙 Mon enregistrement</h2><p class="mut">Écoute la phrase, enregistre-toi, puis compare.</p>
  <div class="row"><button class="btn" id="rb">⏺ Enregistrer</button><button class="btn alt" id="rs">⏹ Arrêter</button></div><audio id="ra" controls style="width:100%;display:none"></audio></div>

  <div class="card"><h2>🎤 Test de prononciation</h2>
  <input id="tg" value="${esc(store.get("tg","I would like some water, please."))}">
  <button class="btn" id="sb" style="margin-top:8px">🎤 Dire la phrase</button><div id="sr" style="margin-top:8px"></div>
  <p class="mut">La reconnaissance vocale dépend de ton navigateur (souvent besoin d'Internet). Sinon, utilise l'enregistrement ci-dessus.</p></div>

  <h2>Conseils pour francophones</h2>`+
  TIPS.map(t=>`<details><summary>${esc(t[0])}</summary><p>${esc(t[1])}</p><div class="chips">${t[2].map(w=>`<button class="chip" data-say="${esc(w)}">🔊 ${esc(w)}</button>`).join("")}</div></details>`).join("")+
  `<h2>Dialogues</h2>`+DIALOGS.map(d=>`<details><summary>${esc(d.t)}</summary>${d.l.map(x=>`<div class="ex"><div>${esc(x)}</div>${sayBtn(x)}</div>`).join("")}<p></p></details>`).join("");

  const fillV=()=>{const sel=$("#pv");sel.innerHTML=`<option value="">Voix par défaut</option>`+voices().map(v=>`<option value="${esc(v.name)}" ${v.name===store.get("voice","")?"selected":""}>${esc(v.name)} (${esc(v.lang)})</option>`).join("")};
  fillV();if("speechSynthesis" in window)speechSynthesis.onvoiceschanged=fillV;
  $("#pv").onchange=e=>store.set("voice",e.target.value);
  const rv=()=>{$("#rv").textContent=$("#pr").value+"×"};rv();
  $("#pr").oninput=e=>{store.set("rate",parseFloat(e.target.value));rv()};
  $("#pb").onclick=()=>{store.set("pt",$("#pt").value);speak($("#pt").value)};
  $("#ps").onclick=()=>{if("speechSynthesis" in window)speechSynthesis.cancel()};

  let rec,chunks=[];
  $("#rb").onclick=async()=>{
    try{const st=await navigator.mediaDevices.getUserMedia({audio:true});rec=new MediaRecorder(st);chunks=[];
      rec.ondataavailable=e=>chunks.push(e.data);
      rec.onstop=()=>{st.getTracks().forEach(t=>t.stop());const a=$("#ra");a.src=URL.createObjectURL(new Blob(chunks));a.style.display="block";a.play()};
      rec.start();toast("Enregistrement… parle !")}catch(e){toast("Micro indisponible ou refusé")}};
  $("#rs").onclick=()=>{if(rec&&rec.state==="recording")rec.stop()};

  $("#sb").onclick=()=>{
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR){toast("Reconnaissance vocale non supportée ici");return}
    const target=$("#tg").value;store.set("tg",target);
    const r=new SR();r.lang="en-US";r.interimResults=false;
    r.onresult=e=>{
      const said=e.results[0][0].transcript,clean=s=>s.toLowerCase().replace(/[^a-z' ]/g,"").split(/\s+/).filter(Boolean);
      const T=clean(target),S=clean(said);let ok=0;T.forEach(w=>{if(S.includes(w))ok++});
      const pct=Math.round(100*ok/Math.max(1,T.length));
      $("#sr").innerHTML=`J'ai entendu : <b>${esc(said)}</b><br>Mots corrects : <b class="${pct>=80?"ok-t":"ko-t"}">${pct}%</b>`};
    r.onerror=()=>toast("Erreur de reconnaissance (réseau ou micro ?)");
    r.start();toast("Parle maintenant…");
  };
};

